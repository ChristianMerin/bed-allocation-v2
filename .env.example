# Copy this file to .env and fill in your values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Cluster > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority
# This subsystem's own database on the cluster
DB_NAME=bed_allocation

# Patient registry (read-only) in the integrated HMS database
PATIENT_DB=medilink_lab_dev
PATIENT_COLLECTION=admit_patients

# Optional one-time copy of ipd_* collections from an older database into DB_NAME
LEGACY_DB=

# First admin account, created only when there are no users yet.
# If ADMIN_PASSWORD is empty, a temporary password is printed in the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# How long a login lasts (hours)
SESSION_HOURS=12

# Optional: shared secret the main HMS server sends in the "x-api-key" header
# (server-to-server calls). Empty = only logged-in users can use the API.
API_KEY=

# Allowed origin(s) for browser calls, comma separated. "*" = any.
CORS_ORIGIN=*

# How long a bed reservation lasts when no "reservedUntil" is given (hours)
DEFAULT_RESERVATION_HOURS=24
